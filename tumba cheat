Title.Text = "ТЕХНИЧЕСКИЕ РАБОТЫ"
Title.Font = Enum.Font.GothamBlack
Title.TextSize = 24
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundTransparency = 1
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Position = UDim2.new(0, 0, 0, 60)
Title.Parent = Frame

-- Подзаголовок
local SubTitle = Instance.new("TextLabel")
SubTitle.Text = "Обновление v2.0"
SubTitle.Font = Enum.Font.GothamBold
SubTitle.TextSize = 14
SubTitle.TextColor3 = Color3.fromRGB(255, 85, 85)
SubTitle.BackgroundTransparency = 1
SubTitle.Size = UDim2.new(1, 0, 0, 20)
SubTitle.Position = UDim2.new(0, 0, 0, 85)
SubTitle.Parent = Frame

-- Текст сообщения
local Message = Instance.new("TextLabel")
Message.Name = "Message"
Message.Text = "Извините, но скрипт временно отключен.\n\nМы проводим финальное тестирование нового глобального обновления. Доступ будет восстановлен сразу после завершения тестов."
Message.Font = Enum.Font.GothamMedium
Message.TextSize = 15
Message.TextColor3 = Color3.fromRGB(180, 180, 190)
Message.BackgroundTransparency = 1
Message.Size = UDim2.new(1, -60, 0, 100)
