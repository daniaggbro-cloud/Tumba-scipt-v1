local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")

-- Создаем GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MaintenanceNotification"
ScreenGui.IgnoreGuiInset = true
ScreenGui.DisplayOrder = 10000 -- Поверх всего

-- Пытаемся поместить в CoreGui для защиты (чтобы было поверх всего), иначе в PlayerGui
pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not ScreenGui.Parent then
    local Players = game:GetService("Players")
    ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Эффект размытия (Blur)
local Blur = Instance.new("BlurEffect")
Blur.Size = 0
Blur.Parent = Lighting

-- Основной фрейм (Окно)
local Frame = Instance.new("Frame")
Frame.Name = "MainFrame"
Frame.Size = UDim2.new(0, 0, 0, 0) -- Начальный размер 0 для анимации
Frame.Position = UDim2.new(0.5, 0, 0.5, 0)
Frame.AnchorPoint = Vector2.new(0.5, 0.5)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30) -- Современный темный фон
Frame.BorderSizePixel = 0
Frame.ClipsDescendants = true
Frame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 16)
UICorner.Parent = Frame

-- Обводка (Glow effect)
local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 85, 85) -- Акцентный цвет (красный/оранжевый)
UIStroke.Thickness = 2
UIStroke.Transparency = 0.5
UIStroke.Parent = Frame

-- Градиент фона
local UIGradient = Instance.new("UIGradient")
UIGradient.Color = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 35, 40)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 25))
}
UIGradient.Rotation = 45
UIGradient.Parent = Frame

-- Иконка
local Icon = Instance.new("TextLabel")
Icon.Text = "🛡️"
Icon.TextSize = 40
Icon.BackgroundTransparency = 1
Icon.Size = UDim2.new(1, 0, 0, 50)
Icon.Position = UDim2.new(0, 0, 0, 15)
Icon.Parent = Frame

